<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DailyDiaryCard</AssemblyName>
    <RootNamespace>DailyDiaryCard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.2</Version>
    <DebugType>embedded</DebugType>
    <StartupObject>DailyDiaryCard.Program</StartupObject>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon Condition="Exists('Assets\diary.ico')">Assets\diary.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Defaults\template.md" LogicalName="DailyDiaryCard.Defaults.template.md" />
    <EmbeddedResource Include="Defaults\background.jpg" LogicalName="DailyDiaryCard.Defaults.background.jpg" />
  </ItemGroup>
</Project>
